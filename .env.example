# Server-only (Cloudflare Workers / wrangler secrets — never expose in client bundles)
ADMIN_PASSWORD=
AUTH_SECRET=

# Optional: Google Search Console HTML tag verification (meta tag on every page)
GOOGLE_SITE_VERIFICATION=

# Optional: Google Analytics 4 (public; loads only after cookie consent)
NEXT_PUBLIC_GA_ID=
# Legacy alias (still supported)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
