{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itsgroup-website",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-XY6BHJ1DRH",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "itsgroup-website",
    },
  ],
  "routes": [
    { "pattern": "itsgroup.mk/*", "zone_name": "itsgroup.mk" },
    { "pattern": "www.itsgroup.mk/*", "zone_name": "itsgroup.mk" },
  ],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itsgroup-db",
      "database_id": "8e3d518b-88e2-49eb-b813-5f055232fcd3",
    },
  ],
}
